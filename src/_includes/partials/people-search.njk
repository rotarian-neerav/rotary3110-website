<form class="search-box" role="search" onsubmit="return false" data-people-search data-year="{{ searchYear }}">
  <label for="people-q">{{ t.people.search }}</label>
  <input id="people-q" type="search" placeholder="e.g. Sharat Chandra, Foundation, President Kanpur" autocomplete="off">
</form>
<div class="search-results" data-people-results aria-live="polite" hidden>
  <p class="small" data-people-count></p>
  <ul class="people-grid"></ul>
</div>
