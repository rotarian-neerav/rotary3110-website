<!doctype html>
<html lang="{{ t.lang }}" data-base="{{ pathPrefix }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " · " + t.district) if title else (t.district + " · " + t.tagline) %}
{%- set pageDescription = description or "News, events and service activities from the Rotary clubs of District 3110." %}
{%- set shareImage = (ogImage | absolute) if ogImage else ("/assets/img/og-default.jpg" | absolute) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription | truncate(180) }}">
<link rel="canonical" href="{{ page.url | absolute }}">
{%- if noindex %}
<meta name="robots" content="noindex, noimageindex">
{%- endif %}
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ t.district }}">
<meta property="og:title" content="{{ title or t.district }}">
<meta property="og:description" content="{{ pageDescription | truncate(180) }}">
<meta property="og:url" content="{{ page.url | absolute }}">
<meta property="og:image" content="{{ shareImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_IN">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#17458F">
<link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="{{ t.district }} – activities and events" href="/feed.xml">
<link rel="preload" href="/assets/fonts/open-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css">
{%- if jsonld %}
<script type="application/ld+json">{{ jsonld | json | safe }}</script>
{%- endif %}
</head>
<body class="{{ bodyClass }}">
<a class="skip" href="#main">{{ t.skip }}</a>
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label="{{ t.district }} home">
      <picture><source srcset="/assets/img/logo.webp" type="image/webp"><img src="/assets/img/logo.png" alt="Rotary District 3110" width="128" height="48"></picture>
    </a>
    <details class="nav-menu">
      <summary><span class="burger" aria-hidden="true"></span>{{ t.menu }}</summary>
      <nav aria-label="Main">
        <ul>
          {%- set navItems = [
            ["/", t.nav.home], ["/activities/", t.nav.activities], ["/events/", t.nav.events], ["/clubs/", t.nav.clubs],
            ["/magazine/", t.nav.magazine], ["/leadership/", t.nav.leadership], ["/teams/", t.nav.teams],
            ["/directory/", t.nav.directory], ["/recognition/", t.nav.recognition], ["/messages/", t.nav.messages] ] %}
          {%- for item in navItems %}
          <li><a href="{{ item[0] }}"{% if page.url == item[0] or (item[0] != '/' and page.url.startsWith(item[0])) %} aria-current="page"{% endif %}>{{ item[1] }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </details>
  </div>
</header>
{%- if site.source == 'sample' or sampleBanner %}
<p class="sample-banner">Test version with sample data. Names in teams and committees are real; everything else is dummy.</p>
{%- endif %}
<main id="main">
{{ content | safe }}
</main>
<footer class="site-footer">
  <div class="wrap">
    <p class="scam"><strong>⚠ {{ t.footer.scam }}</strong></p>
    <div class="footer-grid">
      <div>
        <img src="/assets/img/logo.png" alt="" width="107" height="40" class="footer-logo">
        <p>{{ t.footer.about }}</p>
      </div>
      <ul>
        <li><a href="/submit/">{{ t.footer.submit }}</a></li>
        <li><a href="/club-profile/">{{ t.footer.club_profile }}</a></li>
        <li><a href="/consent/">{{ t.footer.consent }}</a></li>
        <li><a href="/remove/">{{ t.footer.remove }}</a></li>
      </ul>
      <ul>
        <li><a href="/spotlight/">{{ t.nav.spotlight }}</a></li>
        <li><a href="/celebrations/">Celebrations</a></li>
        <li><a href="/privacy/">{{ t.footer.privacy }}</a></li>
        <li><a href="/feed.xml">Updates feed (RSS)</a></li>
      </ul>
    </div>
    <p class="small">Updated {{ site.today | date }}.</p>
  </div>
</footer>
<script src="/assets/js/site.js" defer></script>
{%- for s in scripts %}
<script src="/assets/js/{{ s }}" defer></script>
{%- endfor %}
{%- if analyticsToken %}
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ analyticsToken }}"}'></script>
{%- endif %}
</body>
</html>
