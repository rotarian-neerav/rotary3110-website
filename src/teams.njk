---
layout: layouts/base.njk
pagination:
  data: site.rolesByYear
  size: 1
  addAllPagesToCollections: true
  alias: y
permalink: "{% if y.current %}/teams/{% else %}/teams/{{ y.year }}/{% endif %}"
scripts: ["people-search.js"]
eleventyComputed:
  title: "Teams & Committees {{ y.year }}"
  description: "How Rotary District 3110 is organised in {{ y.year }}: each district team with its leader, and its committees with their chairmen and co-chairmen."
---
{% from "macros.njk" import personCard %}
<div class="wrap section">
  <h1>Teams & Committees <span class="muted">{{ y.year }}</span></h1>
  {% include "partials/year-switch.njk" %}
  {% set searchYear = y.year %}{% include "partials/people-search.njk" %}
  <nav class="jump" aria-label="Teams">{% for tm in y.teams %}<a href="#{{ tm.id }}">{{ tm.name }}</a>{% endfor %}<a href="/leadership/{% if not y.current %}{{ y.year }}/{% endif %}">District Leadership →</a></nav>
  {%- for tm in y.teams %}
  <section class="team" id="{{ tm.id }}">
    <h2>{{ tm.name }}</h2>
    <ul class="people-grid lead-people">{% for r in tm.leaders %}{{ personCard(r) }}{% endfor %}</ul>
    {%- if tm.members.length %}
    <details class="team-members"><summary>{{ tm.members.length }} more in this team</summary>
      <ul class="people-grid">{% for r in tm.members %}{{ personCard(r) }}{% endfor %}</ul>
    </details>
    {%- endif %}
    <div class="committees">
      {%- for cm in tm.committees %}
      <details class="committee" id="{{ cm.id }}"{% if loop.first %} open{% endif %}>
        <summary><span>{{ cm.name }}</span> <span class="small muted">{{ cm.chairs.length + cm.coChairs.length }} people</span></summary>
        <ul class="people-grid">{% for r in cm.chairs %}{{ personCard(r) }}{% endfor %}{% for r in cm.coChairs %}{{ personCard(r) }}{% endfor %}</ul>
      </details>
      {%- endfor %}
    </div>
  </section>
  {%- endfor %}
</div>
