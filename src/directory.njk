---
layout: layouts/base.njk
title: Member directory
description: Find a fellow Rotarian of District 3110 by name, role, profession or place. This year's office bearers, and members who agreed to be listed.
permalink: /directory/
noindex: true
scripts: ["directory.js"]
---
<div class="wrap section">
  <h1>Member directory</h1>
  <p class="lead">{{ t.directory.intro }}</p>
  <form class="filters directory-filters" role="search" data-no-submit data-directory data-wa-hello="{{ t.directory.wa_hello }}">
    <label>{{ t.directory.profession }}
      <select name="profession"><option value="">{{ t.directory.any_profession }}</option>{% for p in site.professions %}<option>{{ p }}</option>{% endfor %}</select>
    </label>
    <label>{{ t.directory.area }}
      <select name="area"><option value="">{{ t.directory.any_area }}</option>{% for a in site.areas %}<option>{{ a }}</option>{% endfor %}</select>
    </label>
    <label class="grow">{{ t.directory.search }}
      <input type="search" name="q" placeholder="e.g. president Agra, or chartered accountant" autocomplete="off">
    </label>
  </form>
  <p class="small" data-directory-count aria-live="polite"></p>
  <ul class="directory-list" data-directory-results></ul>
  <noscript><p>Please turn on JavaScript to search the directory.</p></noscript>
  {%- if site.has.rmb %}<p class="more-links"><a class="more" href="/rmb/">{{ t.rmb.title }}: members' businesses</a></p>{% endif %}
  <p class="small muted">Want to be listed, or to change or remove your listing? <a href="/consent/">Show my details</a> · <a href="/update/">Update my details</a></p>
</div>
