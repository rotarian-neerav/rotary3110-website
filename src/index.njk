---
layout: layouts/base.njk
scripts: ["celebrations.js"]
eleventyComputed:
  jsonld:
    "@context": "https://schema.org"
    "@type": "Organization"
    name: "Rotary District 3110"
    url: "{{ '/' | absolute }}"
    logo: "{{ '/assets/img/logo.png' | absolute }}"
---
{% from "macros.njk" import activityCard, eventItem, avatar, campaignCard %}
<section class="hero">
  <div class="wrap">
    <h1>{{ t.tagline }}</h1>
    <p class="lead">Service projects, events and stories from {{ site.activeClubs.length }} Rotary clubs in {{ site.cities.length }} cities and towns of Uttar Pradesh and Uttarakhand.</p>
    <ul class="stats">
      <li><strong>{{ site.activities.length | number }}</strong> activities shared</li>
      <li><strong>{{ site.stats.clubsPosting }}</strong> clubs posting</li>
      <li><strong>{{ site.stats.peopleHelped | number }}</strong> people helped</li>
    </ul>
    <a class="btn btn-gold" href="/submit/">{{ t.home.share_button }}</a>
  </div>
</section>
{%- if site.bulletin %}
<p class="wrap this-week" id="this-week"><a href="/bulletin/">{{ t.bulletin.home_line }} → {{ site.bulletin.dateLabel }}</a></p>
{%- endif %}
{#- The visitor's phone picks this month's entry; without JavaScript the build month shows -#}
{%- set buildMonth = site.today.slice(5, 7) | int %}
<section class="wrap rotary-month" id="rotary-month" data-rotary-months>
  {%- for m in rotaryMonths %}
  <div class="month-card" data-month="{{ m.month }}"{% if m.month != buildMonth %} hidden{% endif %}>
    <p class="meta">{{ t.home.month_prefix }}</p>
    <p class="month-name">{{ m.name }}</p>
    <p class="small">{{ m.text }} <a href="{{ m.link }}">{{ m.linkText }} →</a></p>
  </div>
  {%- endfor %}
</section>

{#- Order agreed with the district: [campaigns while one runs], events, latest, recognition, spotlight, celebrations, magazine, messages -#}
{%- if site.runningCampaigns.length %}
<section class="wrap section campaign-band" id="campaigns">
  <div class="section-head"><h2>{{ t.campaigns.home_heading }}</h2><a href="/campaigns/">{{ t.campaigns.title }} →</a></div>
  <div class="campaign-grid">
    {%- for c in site.runningCampaigns %}{{ campaignCard(c, t) }}{% endfor %}
  </div>
</section>
{%- endif %}
<section class="wrap section" id="upcoming-events">
  <div class="section-head"><h2>{{ t.home.upcoming }}</h2><a href="/events/">{{ t.home.all_events }}{% if site.upcomingEvents.length > site.homeEvents.length %} ({{ site.upcomingEvents.length }}){% endif %} →</a></div>
  <div class="event-grid">
    {%- for e in site.homeEvents %}{{ eventItem(e, t) }}{% else %}<p>{{ t.events.empty }}</p>{% endfor %}
  </div>
</section>

<section class="wrap section" id="latest">
  <div class="section-head"><h2>{{ t.home.latest }}</h2><a href="/activities/">{{ t.home.all_activities }} →</a></div>
  <div class="grid cards">
    {%- for a in site.activities.slice(0, 6) %}{{ activityCard(a, t) }}{% endfor %}
  </div>
</section>

{%- set r = site.recognition %}
<section class="recognition-band" id="recognition">
  <div class="wrap">
    <div class="section-head"><h2>{{ t.home.recognition }} · {{ r.month | month }}</h2><a href="/recognition/">How it works →</a></div>
    <div class="grid three">
      <div class="award">
        <h3>Most active per member</h3>
        {%- for w in r.mostActive %}<p class="winner"><a href="{{ w.club.url }}">{{ w.club.name }}</a></p><p class="small">{{ w.count }} activities · {{ w.members }} members</p>{% else %}<p class="small">No club posted 3 or more activities this month.</p>{% endfor %}
      </div>
      <div class="award">
        <h3>Most consistent</h3>
        {%- for w in r.mostConsistent %}<p class="winner"><a href="{{ w.club.url }}">{{ w.club.name }}</a></p><p class="small">Posted in {{ w.months }} of {{ r.monthsCounted }} months this Rotary year</p>{% else %}<p class="small">No activities yet this Rotary year.</p>{% endfor %}
      </div>
      <div class="award">
        <h3>Story of the month</h3>
        {%- for s in r.story %}<p class="winner"><a href="{{ s.url }}">{{ s.title }}</a></p><p class="small">{{ s.club.name }}</p>{% else %}<p class="small">The moderators' pick will appear here.</p>{% endfor %}
      </div>
    </div>
  </div>
</section>

{%- if site.spotlight %}
{%- set sp = site.spotlight %}
<section class="wrap section" id="spotlight">
  <div class="section-head"><h2>{{ t.nav.spotlight }}</h2><a href="/spotlight/">More →</a></div>
  <div class="spotlight-card">
    {{ avatar(sp.member.name, sp.image.sq.src if sp.image else '', 80) }}
    <div>
      <p class="meta">{{ sp.monthLabel }}</p>
      <h3>{% if sp.card %}<a href="{{ sp.card }}">{{ sp.member.name }}</a>{% else %}{{ sp.member.name }}{% endif %}</h3>
      <p>{{ sp.headline }}</p>
      {%- if sp.club %}<p class="small">{% if sp.member.profession %}{{ sp.member.profession }} · {% endif %}{{ sp.club.name }}</p>{% endif %}
    </div>
  </div>
</section>
{%- endif %}

<section class="wrap celebrations-strip" id="celebrations" data-nosnippet hidden>
  <h2>{{ t.home.celebrations }}</h2>
  <ul class="celebration-list" data-celebrations="week"></ul>
  <p class="small"><a href="/celebrations/">All celebrations</a> · {{ t.celebrations.note }}</p>
</section>

<div class="wrap two-col section">
  {%- set mag = site.magazines[0] %}
  {%- if mag %}
  <section class="magazine-feature" id="magazine">
    <div class="section-head"><h2>{{ t.home.magazine }}</h2><a href="/magazine/">{{ t.home.archive }} →</a></div>
    <a class="cover-link" href="{{ mag.href }}"{% if mag.external %} target="_blank" rel="noopener"{% endif %}>
      {%- if mag.image %}<img src="{{ mag.image.card.src }}" alt="Cover of {{ mag.title }}" width="{{ mag.image.card.width }}" height="{{ mag.image.card.height }}" loading="lazy">{% endif %}
      <span><strong>{{ mag.title }}</strong><br>{{ t.home.read_issue }} (PDF) →</span>
    </a>
  </section>
  {%- endif %}
  {%- set msg = site.messages[0] %}
  {%- if msg %}
  <section id="messages">
    <div class="section-head"><h2>{{ t.nav.messages }}</h2><a href="/messages/">All messages →</a></div>
    <blockquote class="message-teaser">
      <p>{{ msg.message | truncate(220) }}</p>
      <footer>{{ msg.name }}, {{ msg.position }}</footer>
    </blockquote>
  </section>
  {%- endif %}
</div>

<section class="cta-band">
  <div class="wrap">
    <h2>{{ t.home.share_cta }}</h2>
    <p>{{ t.home.share_cta_text }}</p>
    <a class="btn btn-gold" href="/submit/">{{ t.home.share_button }}</a>
  </div>
</section>
