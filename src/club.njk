---
layout: layouts/base.njk
pagination:
  data: site.clubs
  size: 1
  addAllPagesToCollections: true
  alias: c
permalink: "{{ c.url }}"
eleventyComputed:
  title: "{{ c.display_name }}"
  description: "{{ c.display_name }}, {{ c.city }} – office bearers, meetings{% if c.services.length %}, regular services{% endif %} and service activities. Part of Rotary District 3110, {{ c.zone }} Zone."
---
{% from "macros.njk" import activityCard, avatar %}
<div class="wrap section">
  <p class="meta">{{ c.zone }} Zone · {{ c.city }}{% if c.status != 'active' %} · <strong>No longer active</strong>{% endif %}</p>
  <h1>{{ c.display_name }}</h1>
  {%- if c.former_names.length %}<p class="small muted">Formerly {{ c.former_names | join(', ') }}</p>{% endif %}
  {%- if c.meeting %}<p>🗓 Meets: {{ c.meeting }}</p>{% endif %}
  {%- set links = [["website", "Website"], ["facebook", "Facebook"], ["instagram", "Instagram"], ["youtube", "YouTube"], ["x", "X"], ["linkedin", "LinkedIn"]] %}
  <p class="link-buttons">
    {%- for l in links %}{% if c.links[l[0]] %}<a class="btn btn-outline" href="{{ c.links[l[0]] }}" target="_blank" rel="noopener">{{ l[1] }} ↗</a>{% endif %}{% endfor %}
  </p>

  {%- if c.officers.length %}
  <h2>Office bearers {{ site.rotaryYear }}</h2>
  <ul class="people-grid">
    {%- for o in c.officers %}
    <li class="person">{{ avatar(o.name, o.image.sq.src if o.image else '', 48) }}<div><strong>{% if o.card %}<a href="{{ o.card }}">{{ o.name }}</a>{% else %}{{ o.name }}{% endif %}</strong><span class="role">{{ o.role }}</span></div></li>
    {%- endfor %}
  </ul>
  {%- endif %}
  <p><a class="btn btn-outline" href="{{ c.membersUrl }}">See all members ({{ c.members.length }} listed) →</a></p>

  {%- if c.services.length %}
  <section id="services">
    <h2>{{ t.club.services }}</h2>
    <ul class="club-items">
      {%- for s in c.services %}
      <li><strong>{{ s.what }}</strong>{% if s.when %}<span>{{ s.when }}</span>{% endif %}{% if s.where %}<span class="muted">{{ s.where }}</span>{% endif %}</li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}
  {%- if c.projects.length %}
  <section id="projects">
    <h2>{{ t.club.projects }}</h2>
    <ul class="club-items">
      {%- for p in c.projects %}
      <li><strong>{{ p.name }}</strong>{% if p.what %}<span>{{ p.what }}</span>{% endif %}{% if p.where %}<span class="muted">{{ p.where }}</span>{% endif %}</li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}
  {%- if c.services.length or c.projects.length %}
  <p class="small"><a href="/club-profile/">{{ t.club.missing }}</a></p>
  {%- endif %}
  {%- if c.campaigns.length %}
  <p class="campaign-line"><strong>{{ t.club.campaigns_this_year }}:</strong> {% for x in c.campaigns %}<a href="{{ x.campaign.url }}">{{ x.campaign.name }}</a> – {{ x.count | number }} {{ x.campaign.unit }}{% if not loop.last %}; {% endif %}{% endfor %}</p>
  {%- endif %}

  <h2>Activities</h2>
  {%- if c.activities.length %}
  <div class="grid cards">{% for a in c.activities %}{{ activityCard(a, t) }}{% endfor %}</div>
  {%- else %}
  <p>No activities shared yet. <a href="/submit/">Share your club's first activity</a>.</p>
  {%- endif %}
  <p class="small"><a href="/club-profile/">{{ t.club.update_profile }}</a></p>
</div>
